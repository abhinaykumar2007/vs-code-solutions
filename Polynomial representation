#include <stdio.h>
#include <stdlib.h>

struct Node {
    int coefficient;
    int exponent;
    struct Node *next;
};

// Create a new node
struct Node* createNode(int coeff, int exp) {
    struct Node *newNode;

    newNode = (struct Node*)malloc(sizeof(struct Node));

    newNode->coefficient = coeff;
    newNode->exponent = exp;
    newNode->next = NULL;

    return newNode;
}

// Display polynomial
void display(struct Node *poly) {
    while (poly != NULL) {
        printf("%dx^%d", poly->coefficient, poly->exponent);

        if (poly->next != NULL)
            printf(" + ");

        poly = poly->next;
    }

    printf("\n");
}

int main() {
    struct Node *poly = NULL, *newNode, *temp;
    int n, i, coeff, exp;

    printf("Enter number of terms: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("Enter coefficient and exponent: ");
        scanf("%d %d", &coeff, &exp);

        newNode = createNode(coeff, exp);

        if (poly == NULL) {
            poly = newNode;
        } else {
            temp = poly;

            while (temp->next != NULL) {
                temp = temp->next;
            }

            temp->next = newNode;
        }
    }

    printf("Polynomial is:\n");
    display(poly);

    return 0;
}
